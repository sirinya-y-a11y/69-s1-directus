# API
# Directus
# Base URL: http://localhost:8055


# ============================================================
# 1. Doctor
# ============================================================

### 1.1 Doctor Login
POST {{$dotenv API_BASE_URL}}/auth/login
Content-Type: application/json

{
    "email": "{{$dotenv DOCTOR_LOGIN_EMAIL}}",
    "password": "{{$dotenv DOCTOR_LOGIN_PASSWORD}}"
}


### 1.2 Doctor Forgot Password
POST {{$dotenv API_BASE_URL}}/auth/password/request
Content-Type: application/json

{
    "email": "{{$dotenv DOCTOR_FORGOT_EMAIL}}"
}


### 1.2.1 Doctor Reset Password
POST {{$dotenv API_BASE_URL}}/auth/password/reset
Content-Type: application/json

{
    "token": "{{$dotenv DOCTOR_RESET_TOKEN}}",
    "password": "{{$dotenv DOCTOR_NEW_PASSWORD}}"
}


### 1.3 Doctor Profile
GET {{$dotenv API_BASE_URL}}/users/me
Authorization: Bearer {{$dotenv DOCTOR_PROFILE_TOKEN}}



# ============================================================
# 2. Receptionist
# ============================================================

### 2.1 Receptionist Login
POST {{$dotenv API_BASE_URL}}/auth/login
Content-Type: application/json

{
    "email": "{{$dotenv RECEPTIONIST_LOGIN_EMAIL}}",
    "password": "{{$dotenv RECEPTIONIST_LOGIN_PASSWORD}}"
}


### 2.2 Receptionist Forgot Password
POST {{$dotenv API_BASE_URL}}/auth/password/request
Content-Type: application/json

{
    "email": "{{$dotenv RECEPTIONIST_FORGOT_EMAIL}}"
}


### 2.2.1 Receptionist Reset Password
POST {{$dotenv API_BASE_URL}}/auth/password/reset
Content-Type: application/json

{
    "token": "{{$dotenv RECEPTIONIST_RESET_TOKEN}}",
    "password": "{{$dotenv RECEPTIONIST_NEW_PASSWORD}}"
}


### 2.3 Receptionist Profile
GET {{$dotenv API_BASE_URL}}/users/me
Authorization: Bearer {{$dotenv RECEPTIONIST_PROFILE_TOKEN}}



# ============================================================
# 3. Content
# ============================================================


# ============================================================
# 3.1 Patient
# ใช้ Token ของ Receptionist
# ============================================================

### 3.1.1 Create
POST {{$dotenv API_BASE_URL}}/items/patients
Content-Type: application/json
Authorization: Bearer {{$dotenv PATIENT_CREATE_TOKEN}}

{
    "patient_code": "{{$dotenv PATIENT_CREATE_CODE}}",
    "first_name": "{{$dotenv PATIENT_CREATE_FIRST_NAME}}",
    "last_name": "{{$dotenv PATIENT_CREATE_LAST_NAME}}",
    "gender": "{{$dotenv PATIENT_CREATE_GENDER}}",
    "phone": "{{$dotenv PATIENT_CREATE_PHONE}}",
    "date_of_birth": "{{$dotenv PATIENT_CREATE_DATE_OF_BIRTH}}"
}


### 3.1.2 List All
GET {{$dotenv API_BASE_URL}}/items/patients
Authorization: Bearer {{$dotenv PATIENT_LIST_TOKEN}}


### 3.1.3 List with ID
GET {{$dotenv API_BASE_URL}}/items/patients/{{$dotenv PATIENT_LIST_ID}}
Authorization: Bearer {{$dotenv PATIENT_LIST_ID_TOKEN}}


### 3.1.4 Update
PATCH {{$dotenv API_BASE_URL}}/items/patients/{{$dotenv PATIENT_UPDATE_ID}}
Content-Type: application/json
Authorization: Bearer {{$dotenv PATIENT_UPDATE_TOKEN}}

{
    "patient_code": "{{$dotenv PATIENT_UPDATE_CODE}}",
    "first_name": "{{$dotenv PATIENT_UPDATE_FIRST_NAME}}",
    "last_name": "{{$dotenv PATIENT_UPDATE_LAST_NAME}}",
    "gender": "{{$dotenv PATIENT_UPDATE_GENDER}}",
    "phone": "{{$dotenv PATIENT_UPDATE_PHONE}}",
    "date_of_birth": "{{$dotenv PATIENT_UPDATE_DATE_OF_BIRTH}}"
}


### 3.1.5 Delete
DELETE {{$dotenv API_BASE_URL}}/items/patients/{{$dotenv PATIENT_DELETE_ID}}
Authorization: Bearer {{$dotenv PATIENT_DELETE_TOKEN}}



