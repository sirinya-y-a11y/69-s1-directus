    "doctor_id": "{{$dotenv APPOINTMENT_CREATE_DOCTOR_ID}}",
    "appointment_date": "{{$dotenv APPOINTMENT_CREATE_DATE}}",
    "symptom": "{{$dotenv APPOINTMENT_CREATE_SYMPTOM}}",
    "status": "{{$dotenv APPOINTMENT_CREATE_STATUS}}"
}


### 3.3.2 List All
GET {{$dotenv API_BASE_URL}}/items/appointments
Authorization: Bearer {{$dotenv APPOINTMENT_LIST_TOKEN}}


