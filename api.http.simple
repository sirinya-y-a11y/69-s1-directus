PATCH {{$dotenv API_BASE_URL}}/items/appointments/{{$dotenv APPOINTMENT_UPDATE_ID}}
Content-Type: application/json
Authorization: Bearer {{$dotenv APPOINTMENT_UPDATE_TOKEN}}

{
    "patient_id": "{{$dotenv APPOINTMENT_UPDATE_PATIENT_ID}}",
    "doctor_id": "{{$dotenv APPOINTMENT_UPDATE_DOCTOR_ID}}",
    "appointment_date": "{{$dotenv APPOINTMENT_UPDATE_DATE}}",
    "symptom": "{{$dotenv APPOINTMENT_UPDATE_SYMPTOM}}",
    "status": "{{$dotenv APPOINTMENT_UPDATE_STATUS}}"
}


